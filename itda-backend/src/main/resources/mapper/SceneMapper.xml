<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itda.backend.scene.repository.SceneMapper">

    <resultMap id="SceneResultMap" type="com.itda.backend.scene.domain.Scene">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="orderIndex" column="order_index"/>
        <result property="activeMasterNodeId" column="active_master_node_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="SceneSummaryMap" type="com.itda.backend.scene.repository.dto.SceneSummary">
        <id property="sceneId" column="scene_id"/>
        <result property="title" column="title"/>
        <result property="orderIndex" column="order_index"/>
    </resultMap>

    <insert id="insertScene" parameterType="com.itda.backend.scene.domain.Scene"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO scenes (project_id, title, description, order_index)
        VALUES (#{projectId}, #{title}, #{description}, #{orderIndex})
    </insert>

    <select id="findById" resultMap="SceneResultMap">
        SELECT id, project_id, title, description, order_index, active_master_node_id, created_at, updated_at
        FROM scenes
        WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="SceneResultMap">
        SELECT id, project_id, title, description, order_index, active_master_node_id, created_at, updated_at
        FROM scenes
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <select id="findAllByProjectId" resultMap="SceneSummaryMap">
        SELECT id AS scene_id, title, order_index
        FROM scenes
        WHERE project_id = #{projectId}
        ORDER BY order_index ASC, id ASC
    </select>

    <!-- updateScene: dynamic update (null fields ignored) -->
    <update id="updateScene">
        UPDATE scenes
        <set>
            <if test="title != null">
                title = #{title},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <!-- deleteScene: Hard Delete -->
    <delete id="deleteScene">
        DELETE FROM scenes
        WHERE id = #{id}
    </delete>

    <!-- reorderScenes: batch update order_index -->
    <update id="reorderScenes">
        UPDATE scenes
        SET order_index = CASE id
            <foreach collection="orderedSceneIds" item="sceneId" index="idx">
                WHEN #{sceneId} THEN #{idx} + 1
            </foreach>
            ELSE order_index
        END
        WHERE project_id = #{projectId}
          AND id IN
          <foreach collection="orderedSceneIds" item="sceneId" open="(" separator="," close=")">
              #{sceneId}
          </foreach>
    </update>

    <select id="findNextOrderIndex" resultType="int">
        SELECT COALESCE(MAX(order_index), 0) + 1
        FROM scenes
        WHERE project_id = #{projectId}
    </select>

</mapper>
